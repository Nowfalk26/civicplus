{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
